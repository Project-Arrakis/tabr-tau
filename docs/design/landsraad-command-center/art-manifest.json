{
  "purpose": "Runtime art of the Command Center (milestone M2): optimized local copies of the game artwork in docs/art/landsraad, served from internal/web/static/lcc/art and the two cloth standards' feet (role standard-tip). Game artwork belongs to Funcom and is outside the repository licence (docs/art-notice.md); the two feet are design artwork supplied by the project owner. Both are described there. (The five 84 x 84 specialization badge crops of the approved design were removed on 2026-11-18, #963: the House card draws the banner pictures instead.) The tests compare this file with the embedded files byte for byte.",
  "runtimeRoot": "internal/web/static/lcc/art/",
  "format": "webp with alpha, encoded once from the reference PNG with the browser image encoder (quality 1.0 for the house symbols, 0.92 for the lane, banner and decree pictures); the reference PNG stays the source of truth",
  "sizes": {
    "house": "128 x 128 (the reference size)",
    "lane": "256 x 256 (the reference size)",
    "banner": "256 x 256: the reference banners are 256 x 256 and the folder README now says so too (it said 512 x 512 before M2); recorded in 05-m2-visual-foundation.md",
    "decree": "128 x 128 (down from the 256 x 256 reference; shown at 96 px at most)",
    "faction-mark": "256 x 256 (down from the 512 x 512 reference; shown at 150 px at most): the white faction crest on the header shields, the cloth standards and the claimed 13th seat",
    "standard-tip": "320 x 111 and 319 x 111 PNG, the exact pixels of the approved plaque (no re-drawing, no re-encoding to a lossy format): the gold-edged V point of each cloth standard with its wheat ornament, rows 16 to 126 of the 150-row crop so that no baked-in text is in the picture; the files are design artwork supplied by the project owner, not game artwork",
    "faction-medal": "the reference size (100 x 100 Atreides, 104 x 104 Harkonnen): the round medallion of a claimed seat"
  },
  "houseAlias": {
    "mikarrol": "mikkarol"
  },
  "houseAliasNote": "The save and the editor spell the House Mikkarol; the reference picture and public trackers spell it Mikarrol. The runtime file is mikkarol.webp. Both spellings resolve through this explicit table; a file name is never built from a House name.",
  "decreeArt": {
    "ExperienceRateIncrease": {
      "file": "scholarly-collaboration",
      "basis": "name"
    },
    "RangedDamageIncreased": {
      "file": "honor-of-the-fallen",
      "basis": "subject"
    },
    "MeleeDamageIncreased": {
      "file": "honor-of-the-fallen",
      "basis": "subject"
    },
    "CraftingCostReduced": {
      "file": "production-contract",
      "basis": "name"
    },
    "DropInventoryOnDefeatActive": {
      "file": "loot",
      "basis": "subject"
    },
    "RepairAndRefiningTimes": {
      "file": "repair-cost-reduction",
      "basis": "subject"
    },
    "SpecialVendorActive_Vehicles": {
      "file": "vendor-vehicles",
      "basis": "name"
    },
    "SpecialVendorActive_Weapons": {
      "file": "vendor-weapons",
      "basis": "name"
    },
    "SpecialVendorActive_Armor": {
      "file": "vendor-armor",
      "basis": "name"
    },
    "SpecialVendorActive_Utilities": {
      "file": "vendor-utilities",
      "basis": "name"
    }
  },
  "decreeArtNote": "Matched by hand against the editor decree table (internal/ops/decree-names.json). basis \"name\": the picture is named like the decree. basis \"subject\": the picture shows what the decree is about. A decree that is not listed (the plain SpecialVendorActive row, an id the editor has never seen) gets decrees/fallback.svg, never a guessed picture.",
  "decreeNotRuntime": [
    "choam",
    "dagger",
    "exclusive-import-rights",
    "weapon-rifle",
    "xp"
  ],
  "decreeNotRuntimeNote": "Reference pictures that no decree id of the editor table is matched to; they stay in docs/art/landsraad/decrees and are not embedded.",
  "decreeMissing": [
    "vendor-special"
  ],
  "decreeMissingNote": "docs/art/landsraad/README.md lists vendor-special, but the file does not exist; the plain SpecialVendorActive decree uses the neutral picture.",
