# The embedded game schema is compared with the game's own saves, which use LF; keep it LF in every checkout (#104).
internal/save/schema.sql text eol=lf
# Its evidence copy is compared with it byte for byte by a test, so it is LF in every checkout too (#131).
docs/evidence/single-player-schema.ddl.sql text eol=lf
# Shell scripts run under bash on the Windows runner too: a CRLF checkout would break them (#437).
*.sh text eol=lf
