# The embedded game schema is compared with the game's own saves, which use LF; keep it LF in every checkout (#104).
kit/schema/schema.sql text eol=lf
# Its evidence copy is compared with it byte for byte by a test, so it is LF in every checkout too (#131).
docs/evidence/single-player-schema.ddl.sql text eol=lf
# Shell scripts run under bash on the Windows runner too: a CRLF checkout would break them (#437).
*.sh text eol=lf
# The fillable-items snapshot is compared byte for byte with its canonical form by a test, so it is LF in every checkout (#551).
kit/gamedata/**/*.json text eol=lf
# The design module's files are served as they are and one of them is hashed: text stays LF and the font stays binary in every checkout (#572).
design/assets/*.css text eol=lf
design/assets/*.svg text eol=lf
design/assets/fonts/*.txt text eol=lf
design/assets/fonts/SHA256SUMS text eol=lf
design/assets/fonts/*.ttf binary
# The newer layout's DDL and its evidence copy are compared byte for byte too, so they are LF in every checkout (#588).
kit/schema/schema_map_names.sql text eol=lf
docs/evidence/single-player-schema-map-names.ddl.sql text eol=lf
